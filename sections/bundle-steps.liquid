{%- liquid
assign padding_top = section.settings.padding_top | default: 40
assign padding_bottom = section.settings.padding_bottom | default: 40
assign margin_top = section.settings.margin_top | default: 0
assign margin_bottom = section.settings.margin_bottom | default: 0
-%}

<section
  class="bundle-steps"
  style="
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    margin-top: {{ margin_top }}px;
    margin-bottom: {{ margin_bottom }}px;
  "
>
  <div class="bundle-steps__inner">
    <div class="bundle-steps__left">

```
  {%- if section.blocks.size > 0 -%}
    {%- assign total_steps = section.blocks.size -%}

    <div class="bundle-steps__accordion-list">

      {%- for block in section.blocks -%}
        {%- assign step_collection = collections[block.settings.collection] -%}

        <div class="bundle-steps__accordion-step-label">
          STEP {{ forloop.index }} OF {{ total_steps }}
        </div>

        <details
          class="bundle-steps__accordion-item"
          name="bundle-accordion"
          {% if forloop.first %}open{% endif %}
          {{ block.shopify_attributes }}
        >

          <summary class="bundle-steps__accordion-header">

            <div class="bundle-steps__accordion-left">
              <div class="bundle-steps__accordion-title">
                {{ block.settings.step_heading | default: 'Step heading' }}
              </div>
            </div>

            <div class="bundle-steps__accordion-right">

              <span class="bundle-steps__selected-count">
                <span class="bundle-steps__selected-count-value">0</span>
                <span>selected</span>
              </span>

              <span class="bundle-steps__accordion-chevron">⌄</span>

            </div>

          </summary>

          <div class="bundle-steps__accordion-body">
            <div class="bundle-steps__card-body">

              {%- if step_collection and step_collection.products_count > 0 -%}

              <div class="bundle-steps__products-panel">

                <div class="bundle-steps__products-grid">

                  {%- for product in step_collection.products limit: 5 -%}

                  <div class="bundle-steps__product-card">

                    {%- if product.compare_at_price_max > product.price -%}
                      {%- assign discount = product.compare_at_price_max
                      | minus: product.price
                      | times: 100
                      | divided_by: product.compare_at_price_max -%}

                      <span class="bundle-steps__discount-badge">
                        Save {{ discount }}%
                      </span>
                    {%- endif -%}

                    <div class="bundle-steps__product-media">
                      {%- if product.featured_image -%}
                      {{ product.featured_image
                        | image_url: width: 400
                        | image_tag:
                        loading: 'lazy',
                        class: 'bundle-steps__product-image'
                      }}
                      {%- endif -%}
                    </div>

                    <div class="bundle-steps__product-content">

                      <h3 class="bundle-steps__product-title">
                        {{ product.title }}
                      </h3>

                      {%- if product.description != blank -%}
                      <p class="bundle-steps__product-description">
                        {{ product.description | strip_html | truncate: 80 }}
                      </p>
                      {%- endif -%}

                      <div class="bundle-steps__product-options">

                        {%- for option in product.options_with_values -%}
                          {%- if option.name == 'Color' or option.name == 'Colour' -%}

                            {%- for value in option.values -%}
                              <span
                                class="bundle-steps__swatch"
                                style="background: {{ value | downcase }}"
                                title="{{ value }}"
                              ></span>
                            {%- endfor -%}

                          {%- endif -%}
                        {%- endfor -%}

                      </div>

                      <div class="bundle-steps__product-footer">

                        <div class="bundle-steps__qty-control">
                          <button type="button" class="bundle-steps__qty-btn">−</button>
                          <span class="bundle-steps__qty-value">0</span>
                          <button type="button" class="bundle-steps__qty-btn">+</button>
                        </div>

                        <div class="bundle-steps__price">

                          {%- if product.compare_at_price_max > product.price -%}
                            <span class="bundle-steps__compare-at">
                              {{ product.compare_at_price_max | money }}
                            </span>
                          {%- endif -%}

                          <span class="bundle-steps__final-price">
                            {{ product.price | money }}
                          </span>

                        </div>

                      </div>

                    </div>

                  </div>

                  {%- endfor -%}

                </div>

                <div class="bundle-steps__card-footer">
                  <button type="button" class="bundle-steps__primary-btn">
                    {{ block.settings.next_button_label | default: 'Next step' }}
                  </button>
                </div>

              </div>

              {%- else -%}

                <p class="bundle-steps__empty">
                  Select a collection for this step to see its products here.
                </p>

              {%- endif -%}

            </div>
          </div>

        </details>

      {%- endfor -%}

    </div>

  {%- else -%}

    <p class="bundle-steps__empty">
      Add blocks to configure your bundle steps.
    </p>

  {%- endif -%}

</div>

<div class="bundle-steps__right"></div>
```

  </div>
</section>

{% stylesheet %}

.bundle-steps{background:#f4f6fb}

.bundle-steps__inner{
max-width:1400px;
margin:0 auto;
display:grid;
grid-template-columns:3fr 2fr;
gap:24px
}

.bundle-steps__accordion-list{
border-radius:12px;
overflow:hidden;
border:1px solid #dbe1f3;
background:#fff;
padding:1rem
}

.bundle-steps__accordion-step-label{
font-size:11px;
letter-spacing:.1em;
text-transform:uppercase;
color:#a0aac6;
padding-bottom:6px;
margin-bottom:12px;
font-weight:600;
border-bottom:1px solid #c7cbd8
}

.bundle-steps__products-panel{
background:#f5f7ff;
border-radius:20px;
padding:20px;
margin-top:12px;
display:flex;
flex-direction:column;
gap:24px
}

.bundle-steps__products-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:18px
}

.bundle-steps__product-card{
background:#fff;
border-radius:16px;
padding:14px;
display:flex;
flex-direction:column;
gap:8px;
box-shadow:0 1px 4px rgba(0,0,0,.05);
position:relative
}

.bundle-steps__discount-badge{
position:absolute;
top:10px;
left:10px;
background:#5b6bff;
color:#fff;
font-size:11px;
font-weight:600;
padding:4px 10px;
border-radius:20px
}

.bundle-steps__product-media{
height:150px;
display:flex;
align-items:center;
justify-content:center
}

.bundle-steps__product-title{
font-size:14px;
font-weight:600
}

.bundle-steps__product-description{
font-size:12px;
color:#7b88a8
}

.bundle-steps__product-options{
display:flex;
gap:6px
}

.bundle-steps__swatch{
width:16px;
height:16px;
border-radius:50%;
border:1px solid #d0d6ec
}

.bundle-steps__product-footer{
display:flex;
justify-content:space-between;
align-items:center;
margin-top:auto
}

.bundle-steps__qty-control{
display:flex;
border:1px solid #d0d6ec;
border-radius:999px;
overflow:hidden
}

.bundle-steps__qty-btn{
border:none;
background:transparent;
padding:4px 8px;
cursor:pointer;
font-weight:600;
color:#3657ff
}

.bundle-steps__qty-value{
padding:0 8px;
font-weight:600
}

.bundle-steps__compare-at{
font-size:11px;
text-decoration:line-through;
color:#a0aac6;
margin-right:6px
}

.bundle-steps__final-price{
font-weight:700;
color:#3657ff
}

.bundle-steps__primary-btn{
border-radius:999px;
border:1px solid #b8c2ff;
background:#f5f7ff;
color:#3657ff;
padding:10px 22px;
font-weight:700;
cursor:pointer;
min-width:160px
}

.bundle-steps__card-footer{
display:flex;
justify-content:center
}

{% endstylesheet %}

{% schema %}
{
"name":"Bundle steps builder",
"settings":[
{"type":"range","id":"padding_top","label":"Padding top","min":0,"max":120,"step":4,"unit":"px","default":40},
{"type":"range","id":"padding_bottom","label":"Padding bottom","min":0,"max":120,"step":4,"unit":"px","default":40},
{"type":"range","id":"margin_top","label":"Margin top","min":0,"max":120,"step":4,"unit":"px","default":0},
{"type":"range","id":"margin_bottom","label":"Margin bottom","min":0,"max":120,"step":4,"unit":"px","default":0}
],
"blocks":[
{
"type":"step",
"name":"Step",
"settings":[
{"type":"collection","id":"collection","label":"Collection"},
{"type":"text","id":"step_heading","label":"Step heading","default":"Choose your products"},
{"type":"text","id":"next_button_label","label":"Next button label","default":"Next step"}
]
}
],
"presets":[
{
"name":"Bundle steps builder",
"blocks":[{"type":"step"},{"type":"step"},{"type":"step"}]
}
]
}
{% endschema %}
