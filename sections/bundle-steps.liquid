{% stylesheet %}
  .bundle-steps{
  background:#f4f6fb;
  }

  .bundle-steps__inner{
  max-width:1400px;
  margin:0 auto;
  display:grid;
  grid-template-columns:3fr 2fr;
  gap:28px;
  }

  .bundle-steps__left{
  display:flex;
  flex-direction:column;
  gap:18px;
  }

  .bundle-steps__accordion-list{
  background:#fff;
  border-radius:14px;
  border:1px solid #e4e7f5;
  padding:20px;
  }

  .bundle-steps__accordion-step-label{
  font-size:11px;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:#a0aac6;
  font-weight:600;
  margin-bottom:8px;
  }

  .bundle-steps__accordion-item{
  border-top:1px solid #e4e7f5;
  border-bottom:1px solid #e4e7f5;
  overflow:hidden;
  margin-bottom:14px;
  background:#fff;
  }

  .bundle-steps__accordion-header{
  padding:16px 18px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  cursor:pointer;
  }

  .bundle-steps__accordion-title{
  font-size:18px;
  font-weight:700;
  color:#111;
  }

  .bundle-steps__accordion-right{
  display:flex;
  align-items:center;
  gap:10px;
  color:#3657ff;
  font-weight:600;
  }

  .bundle-steps__selected-count{
  display:none;
  font-size:14px;
  }

  .bundle-steps__accordion-item[open] .bundle-steps__selected-count{
  display:inline-flex;
  }

  .bundle-steps__products-panel{
  background:#f5f7ff;
  padding:22px;
  display:flex;
  flex-direction:column;
  gap:24px;
  }

  .bundle-steps__products-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
  }

  .bundle-steps__product-card{
  background:#fff;
  border-radius:16px;
  padding:8px;
  display:flex;
  flex-direction:column;
  gap:10px;
  box-shadow:0 2px 6px rgba(0,0,0,.05);
  }

  .bundle-steps__product-media{
  height:140px;
  display:flex;
  align-items:center;
  justify-content:center;
  }

  .bundle-steps__product-image{
  height:100%;
  width:100%;
  object-fit:contain;
  }

  .bundle-steps__product-title{
  font-size:14px;
  font-weight:600;
  color:#111;
  }

  .bundle-steps__product-options{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  }

  .bundle-steps__swatch{
  display:flex;
  align-items:center;
  gap:6px;
  padding:3px 6px;
  border:1px solid #dbe1f3;
  border-radius:6px;
  background:#fff;
  cursor:pointer;
  font-size:12px;
  }

  .bundle-steps__swatch.is-selected{
  border-color:#0AA288;
  background:#1DF0BB0A;
  }

  .bundle-steps__product-footer{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-top:8px;
  }

  .bundle-steps__qty-control{
  display:flex;
  align-items:center;
  gap:6px;
  }

  .bundle-steps__qty-btn{
  width:18px;
  height:18px;
  border-radius:6px;
  border:1px solid #dbe1f3;
  background:#fff;
  font-weight:700;
  cursor:pointer;
  }

  .bundle-steps__qty-value{
  font-size:14px;
  font-weight:600;
  }

  .bundle-steps__price{
  text-align:right;
  }

  .bundle-steps__final-price{
  font-weight:700;
  color:#3657ff;
  }

  .bundle-review{
  background:#eef2fb;
  border-radius:16px;
  padding:22px;
  position:sticky;
  top:40px;
  }

  .bundle-review__label{
  font-size:11px;
  letter-spacing:.1em;
  color:#94a0c3;
  font-weight:600;
  }

  .bundle-review__desc{
  font-size:13px;
  color:#7b88a8;
  margin-bottom:16px;
  }

  .bundle-review__section{
  margin-bottom:16px;
  }

  .bundle-review__title{
  font-size:11px;
  font-weight:700;
  color:#a0aac6;
  margin-bottom:6px;
  }

  .bundle-review__item{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:6px 0;
  font-size:14px;
  }

  .bundle-review__qty{
  display:flex;
  gap:6px;
  align-items:center;
  }

  .bundle-review__qty button{
  width:20px;
  height:20px;
  border-radius:6px;
  border:1px solid #dbe1f3;
  background:#fff;
  cursor:pointer;
  }

  .bundle-review__shipping{
  display:flex;
  justify-content:space-between;
  padding:10px 0;
  border-top:1px solid #e4e7f5;
  }

  .bundle-review__total{
  display:flex;
  justify-content:space-between;
  align-items:end;
  margin-top:10px;
  }

  .bundle-review__price{
  font-size:22px;
  font-weight:700;
  color:#3657ff;
  }

  .bundle-review__checkout{
  width:100%;
  margin-top:16px;
  background:#5c4cf4;
  color:#fff;
  border:none;
  border-radius:10px;
  padding:14px;
  font-weight:700;
  cursor:pointer;
  }
{% endstylesheet %}

<bundle-steps>
  <section class="bundle-steps">
    <div class="bundle-steps__inner">
      <div class="bundle-steps__left">
        {% if section.blocks.size > 0 %}
          <div class="bundle-steps__accordion-list">
            {% for block in section.blocks %}
              {% assign step_collection = collections[block.settings.collection] %}

              <div class="bundle-steps__accordion-step-label">
                STEP {{ forloop.index }} OF {{ section.blocks.size }}
              </div>

              <details
                class="bundle-steps__accordion-item"
                {% if forloop.first %}
                  open
                {% endif %}
              >
                <summary class="bundle-steps__accordion-header">
                  <div class="bundle-steps__accordion-title">
                    {{ block.settings.step_heading }}
                  </div>

                  <div class="bundle-steps__accordion-right">
                    <span class="bundle-steps__selected-count">
                      <span class="bundle-steps__selected-count-value">0</span> selected
                    </span>
                  </div>
                </summary>

                <div class="bundle-steps__products-panel">
                  <div class="bundle-steps__products-grid">
                    {% for product in step_collection.products limit: 5 %}
                      <div
                        class="bundle-steps__product-card"
                        data-product-id="{{ product.id }}"
                        data-step-title="{{ block.settings.step_heading }}"
                        data-default-variant="{{ product.first_available_variant.id }}"
                        data-has-variants="{% if product.variants.size > 1 %}true{% else %}false{% endif %}"
                      >
                        <div class="bundle-steps__product-media">
                          {{
                            product.featured_image
                            | image_url: width: 400
                            | image_tag: class: 'bundle-steps__product-image'
                          }}
                        </div>

                        <h3 class="bundle-steps__product-title">
                          {{ product.title }}
                        </h3>

                        <div class="bundle-steps__product-options">
                          {% for variant in product.variants %}
                            <button
                              class="bundle-steps__swatch"
                              data-variant-id="{{ variant.id }}"
                              data-product-id="{{ product.id }}"
                            >
                              {{ variant.title }}
                            </button>
                          {% endfor %}
                        </div>

                        <div class="bundle-steps__product-footer">
                          <div class="bundle-steps__qty-control">
                            <button
                              class="bundle-steps__qty-btn"
                              data-action="decrease"
                            >
                              -
                            </button>

                            <span class="bundle-steps__qty-value">0</span>

                            <button
                              class="bundle-steps__qty-btn"
                              data-action="increase"
                            >
                              +
                            </button>
                          </div>

                          <div class="bundle-steps__price">
                            <span class="bundle-steps__final-price">
                              {{ product.price | money }}
                            </span>
                          </div>
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              </details>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="bundle-steps__right">
        <div class="bundle-review">
          <p class="bundle-review__label">REVIEW</p>

          <h3>Your security system</h3>

          <p class="bundle-review__desc">
            Review your personalized protection system designed to keep what matters most safe.
          </p>

          <div class="bundle-review__shipping">Fast Shipping <span>FREE</span></div>

          <div class="bundle-review__total">
            <div>Total</div>
            <div class="bundle-review__price" data-total-price>$0.00</div>
          </div>

          <button class="bundle-review__checkout">Checkout</button>
        </div>
      </div>
    </div>
  </section>
</bundle-steps>

<script>
  class BundleSteps extends HTMLElement {
    constructor() {
      super();
      this.state = {};
    }

    connectedCallback() {
      this.initSwatches();
      this.initQuantity();
      this.initReviewButtons();
    }

    getStepId(card) {
      const acc = card.closest('.bundle-steps__accordion-item');

      if (!acc.dataset.stepId) {
        acc.dataset.stepId = Math.random().toString(36).substring(2, 9);
      }

      return acc.dataset.stepId;
    }

    getStateKey(card, variantId) {
      return `${this.getStepId(card)}-${card.dataset.productId}-${variantId}`;
    }

    initSwatches() {
      this.querySelectorAll('.bundle-steps__swatch').forEach((swatch) => {
        swatch.addEventListener('click', () => {
          const card = swatch.closest('.bundle-steps__product-card');

          card.querySelectorAll('.bundle-steps__swatch').forEach((btn) => {
            btn.classList.remove('is-selected');
          });

          swatch.classList.add('is-selected');

          card.dataset.variantId = swatch.dataset.variantId;
        });
      });
    }

    initQuantity() {
      this.querySelectorAll('.bundle-steps__qty-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const card = btn.closest('.bundle-steps__product-card');

          const qtyEl = card.querySelector('.bundle-steps__qty-value');

          let variantId = card.dataset.variantId;

          if (!variantId) {
            variantId = card.dataset.defaultVariant;
            card.dataset.variantId = variantId;
          }

          const key = this.getStateKey(card, variantId);

          if (!this.state[key]) this.state[key] = 0;

          if (btn.dataset.action === 'increase') this.state[key]++;

          if (btn.dataset.action === 'decrease' && this.state[key] > 0) this.state[key]--;

          qtyEl.textContent = this.state[key];

          this.updateReview();
        });
      });
    }

    updateReview() {
      const review = this.querySelector('.bundle-review');

      review.querySelectorAll('.bundle-review__dynamic').forEach((el) => el.remove());

      let groups = {};
      let total = 0;

      Object.keys(this.state).forEach((key) => {
        const qty = this.state[key];

        if (qty <= 0) return;

        const parts = key.split('-');
        const productId = parts[1];

        const card = this.querySelector(`[data-product-id="${productId}"]`);

        const stepTitle = card.dataset.stepTitle;
        const title = card.querySelector('.bundle-steps__product-title').textContent;

        const price = parseFloat(card.querySelector('.bundle-steps__final-price').textContent.replace(/[^0-9.]/g, ''));

        if (!groups[stepTitle]) groups[stepTitle] = [];

        groups[stepTitle].push({
          key,
          title,
          qty,
          price,
        });

        total += price * qty;
      });

      const shipping = review.querySelector('.bundle-review__shipping');

      Object.keys(groups).forEach((step) => {
        const section = document.createElement('div');

        section.className = 'bundle-review__section bundle-review__dynamic';

        section.innerHTML = `<p class="bundle-review__title">${step.replace(/choose your/i, '').toUpperCase()}</p>`;

        groups[step].forEach((item) => {
          const row = document.createElement('div');

          row.className = 'bundle-review__item';

          row.innerHTML = `
<span>${item.title}</span>

<div class="bundle-review__qty">
<button data-review-minus="${item.key}">-</button>
<span>${item.qty}</span>
<button data-review-plus="${item.key}">+</button>
</div>

<span>$${(item.qty * item.price).toFixed(2)}</span>
`;

          section.appendChild(row);
        });

        review.insertBefore(section, shipping);
      });

      this.querySelector('[data-total-price]').textContent = `$${total.toFixed(2)}`;
    }

    initReviewButtons() {
      this.addEventListener('click', (e) => {
        if (e.target.dataset.reviewPlus) {
          this.state[e.target.dataset.reviewPlus]++;
        }

        if (e.target.dataset.reviewMinus) {
          if (this.state[e.target.dataset.reviewMinus] > 0) {
            this.state[e.target.dataset.reviewMinus]--;
          }
        }

        this.refreshUI();
      });
    }

    refreshUI() {
      this.querySelectorAll('.bundle-steps__product-card').forEach((card) => {
        const variantId = card.dataset.variantId || card.dataset.defaultVariant;

        const key = this.getStateKey(card, variantId);

        const qty = this.state[key] || 0;

        card.querySelector('.bundle-steps__qty-value').textContent = qty;
      });

      this.updateReview();
    }
  }

  customElements.define('bundle-steps', BundleSteps);
</script>

{% schema %}
{
  "name": "Bundle steps builder",
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "step_heading",
          "default": "Choose your products",
          "label": "Step heading"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle steps builder",
      "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }]
    }
  ]
}
{% endschema %}
