{%- liquid
assign padding_top = section.settings.padding_top | default: 40
assign padding_bottom = section.settings.padding_bottom | default: 40
assign margin_top = section.settings.margin_top | default: 0
assign margin_bottom = section.settings.margin_bottom | default: 0
-%}

<section
  class="bundle-steps"
  style="
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    margin-top: {{ margin_top }}px;
    margin-bottom: {{ margin_bottom }}px;
  "
>
  <div class="bundle-steps__inner">
    <div class="bundle-steps__left">

      {%- if section.blocks.size > 0 -%}
        {%- assign total_steps = section.blocks.size -%}

        <div class="bundle-steps__accordion-list">

          {%- for block in section.blocks -%}
            {%- assign step_collection = collections[block.settings.collection] -%}

            <details
              class="bundle-steps__accordion-item"
              name="bundle-accordion"
              {% if forloop.first %}open{% endif %}
              {{ block.shopify_attributes }}
            >

              <!-- Step label inside the block -->
              <div class="bundle-steps__accordion-step-label">
                STEP {{ forloop.index }} OF {{ total_steps }}
              </div>

              <summary class="bundle-steps__accordion-header">

                <div class="bundle-steps__accordion-left">
                  <div class="bundle-steps__accordion-title">
                    {{ block.settings.step_heading | default: 'Step heading' }}
                  </div>
                </div>

                <div class="bundle-steps__accordion-right">

                  <span class="bundle-steps__selected-count">
                    <span class="bundle-steps__selected-count-value">0</span>
                    <span>selected</span>
                  </span>

                  <span class="bundle-steps__accordion-chevron">⌄</span>

                </div>

              </summary>

              <div class="bundle-steps__accordion-body">

                <div class="bundle-steps__card-body">

                  {%- if step_collection and step_collection.products_count > 0 -%}

                    <div class="bundle-steps__products-panel">

                      <div class="bundle-steps__products-grid">

                        {%- for product in step_collection.products limit: 5 -%}

                          <div class="bundle-steps__product-card">

                            <div class="bundle-steps__product-media">

                              {%- if product.featured_image -%}
                                {{ product.featured_image
                                  | image_url: width: 400
                                  | image_tag:
                                    loading: 'lazy',
                                    class: 'bundle-steps__product-image'
                                }}
                              {%- endif -%}

                            </div>

                            <div class="bundle-steps__product-content">

                              <h3 class="bundle-steps__product-title">
                                {{ product.title }}
                              </h3>

                              {%- if product.description != blank -%}
                                <p class="bundle-steps__product-description">
                                  {{ product.description | strip_html | truncate: 80 }}
                                </p>
                              {%- endif -%}

                              <div class="bundle-steps__product-options">
                                <span class="bundle-steps__swatch bundle-steps__swatch--white"></span>
                                <span class="bundle-steps__swatch bundle-steps__swatch--black"></span>
                              </div>

                              <div class="bundle-steps__product-footer">

                                <div class="bundle-steps__qty-control">
                                  <button type="button" class="bundle-steps__qty-btn">-</button>
                                  <span class="bundle-steps__qty-value">0</span>
                                  <button type="button" class="bundle-steps__qty-btn">+</button>
                                </div>

                                <div class="bundle-steps__price">

                                  {%- if product.compare_at_price_max > product.price -%}
                                    <span class="bundle-steps__compare-at">
                                      {{ product.compare_at_price_max | money }}
                                    </span>
                                  {%- endif -%}

                                  <span class="bundle-steps__final-price">
                                    {{ product.price | money }}
                                  </span>

                                </div>

                              </div>

                            </div>

                          </div>

                        {%- endfor -%}

                      </div>

                      <!-- Next button footer centered -->
                      <div class="bundle-steps__card-footer">
                        <button type="button" class="bundle-steps__primary-btn">
                          {{ block.settings.next_button_label | default: 'Next step' }}
                        </button>
                      </div>

                    </div>

                  {%- else -%}

                    <p class="bundle-steps__empty">
                      Select a collection for this step to see its products here.
                    </p>

                  {%- endif -%}

                </div>

              </div>

            </details>

          {%- endfor -%}

        </div>

      {%- else -%}

        <p class="bundle-steps__empty">
          Add blocks to configure your bundle steps.
        </p>

      {%- endif -%}

    </div>

    <div class="bundle-steps__right">
      <!-- Right side empty for now -->
    </div>

  </div>
</section>

{% stylesheet %}

.bundle-steps {
  background: #f4f6fb;
}

.bundle-steps__inner {
  max-width: 1400px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 3fr 2fr;
  gap: 24px;
}

.bundle-steps__left {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.bundle-steps__accordion-list {
  border-radius: 12px;
  overflow: visible;
}

/* Details styling - unified block background for active */
details.bundle-steps__accordion-item {
  border-radius: 12px;
  margin-bottom: 24px;
  border: 1px solid transparent;
  background: transparent;
  overflow: visible;
  transition: background-color 0.3s ease, border-color 0.3s ease;
}

/* Step label inside details, with border line */
.bundle-steps__accordion-step-label {
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #6b7280; /* gray-500 */
  font-weight: 600;
  padding: 10px 20px 6px 20px;
  border-bottom: 1px solid #c7cbd8;
  user-select: none;
}

/* Summary - heading block */
.bundle-steps__accordion-header {
  padding: 14px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  background: #fff;
  border-bottom: 1px solid #c7cbd8;
  border-radius: 0;
  font-weight: 700;
  font-size: 18px;
  color: #111827; /* gray-900 */
  transition: background-color 0.3s ease, color 0.3s ease;
}

.bundle-steps__accordion-header::-webkit-details-marker {
  display: none;
}

/* Right side of header */
.bundle-steps__accordion-right {
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 600;
  color: #3657ff;
  user-select: none;
}

/* Hide selected count by default */
.bundle-steps__selected-count {
  display: none;
  font-size: 14px;
  white-space: nowrap;
}

/* Arrow icon */
.bundle-steps__accordion-chevron {
  transition: transform 0.25s ease;
  font-size: 18px;
  color: #3657ff;
}

/* Rotate arrow when open */
.bundle-steps__accordion-item[open] .bundle-steps__accordion-chevron {
  transform: rotate(180deg);
}

/* Show selected count and hide arrow when open */
.bundle-steps__accordion-item[open] .bundle-steps__selected-count {
  display: inline-flex;
}

/* Active/open details style */
.bundle-steps__accordion-item[open] {
  background: #f4f6fb;
  border-color: #dbe1f3;
  box-shadow: 0 3px 8px rgb(54 87 255 / 0.15);
  z-index: 1;
}

/* Also style summary inside open details */
.bundle-steps__accordion-item[open] > summary {
  background: transparent;
  color: #3657ff;
  border-bottom: none;
  font-weight: 800;
}

/* Step label color for active */
.bundle-steps__accordion-item[open] .bundle-steps__accordion-step-label {
  color: #3657ff;
  font-weight: 700;
}

/* Accordion body */
.bundle-steps__accordion-body {
  padding: 20px;
}

/* Product panel styles */
.bundle-steps__products-panel {
  background: #f4f6fb;
  border-radius: 20px;
  padding: 20px;
  margin-top: 0;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.bundle-steps__products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.bundle-steps__product-card {
  background: #fff;
  border-radius: 16px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.05);
  transition: box-shadow 0.3s ease;
  cursor: pointer;
}

.bundle-steps__product-card:hover {
  box-shadow: 0 3px 10px rgba(54, 87, 255, 0.3);
}

.bundle-steps__product-media {
  height: 150px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bundle-steps__product-image {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.bundle-steps__product-title {
  font-size: 14px;
  font-weight: 600;
  color: #111;
}

.bundle-steps__product-description {
  font-size: 12px;
  color: #7b88a8;
  line-height: 1.3;
  min-height: 40px;
}

.bundle-steps__product-options {
  display: flex;
  gap: 6px;
  margin-top: 6px;
}

.bundle-steps__swatch {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 1px solid #d0d6ec;
}

.bundle-steps__swatch--white {
  background: #fff;
}

.bundle-steps__swatch--black {
  background: #000;
}

.bundle-steps__product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.bundle-steps__qty-control {
  display: flex;
  border: 1px solid #d0d6ec;
  border-radius: 999px;
  overflow: hidden;
  user-select: none;
}

.bundle-steps__qty-btn {
  border: none;
  background: transparent;
  padding: 4px 8px;
  cursor: pointer;
  font-weight: 600;
  color: #3657ff;
  user-select: none;
}

.bundle-steps__qty-value {
  padding: 0 8px;
  min-width: 20px;
  text-align: center;
  font-weight: 600;
}

.bundle-steps__price {
  text-align: right;
  font-weight: 600;
}

.bundle-steps__compare-at {
  font-size: 11px;
  text-decoration: line-through;
  color: #a0aac6;
  margin-right: 6px;
}

.bundle-steps__final-price {
  font-weight: 700;
  color: #3657ff;
}

.bundle-steps__primary-btn {
  border-radius: 999px;
  border: 1px solid #b8c2ff;
  background: #3657ff;
  color: #fff;
  padding: 10px 22px;
  font-weight: 700;
  cursor: pointer;
  width: auto;
  min-width: 160px;
  user-select: none;
  transition: background-color 0.3s ease;
  align-self: center;
  box-shadow: 0 4px 8px rgb(54 87 255 / 0.5);
}

.bundle-steps__primary-btn:hover {
  background-color: #2a42cc;
  box-shadow: 0 6px 14px rgb(42 66 204 / 0.75);
}

.bundle-steps__card-footer {
  display: flex;
  justify-content: center;
  background: transparent;
  padding: 0;
}

.bundle-steps__empty {
  padding: 20px;
  color: #7b88a8;
  font-style: italic;
}

@media (max-width: 1024px) {
  .bundle-steps__inner {
    grid-template-columns: 1fr;
  }

  .bundle-steps__products-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Bundle steps builder",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "step_heading",
          "label": "Step heading",
          "default": "Choose your products"
        },
        {
          "type": "text",
          "id": "next_button_label",
          "label": "Next button label",
          "default": "Next step"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle steps builder",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}