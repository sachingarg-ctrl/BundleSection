{% liquid
assign padding_top = section.settings.padding_top | default: 40
assign padding_bottom = section.settings.padding_bottom | default: 40
assign margin_top = section.settings.margin_top | default: 0
assign margin_bottom = section.settings.margin_bottom | default: 0
%}

<section
class="bundle-steps"
style="
padding-top: {{ padding_top }}px;
padding-bottom: {{ padding_bottom }}px;
margin-top: {{ margin_top }}px;
margin-bottom: {{ margin_bottom }}px;
">

<div class="bundle-steps__container">

{% assign total_steps = section.blocks.size %}

{% for block in section.blocks %}

{% assign step_collection = collections[block.settings.collection] %}

<div class="bundle-step">

<div class="bundle-step__label">
STEP {{ forloop.index }} OF {{ total_steps }}
</div>

<details class="bundle-step__accordion" {% if forloop.first %}open{% endif %}>

<summary class="bundle-step__header">

<h3 class="bundle-step__title">
{{ block.settings.step_heading }}
</h3>

</summary>

<div class="bundle-step__content">

{% if step_collection != blank and step_collection.products_count > 0 %}

<div class="bundle-products">

{% for product in step_collection.products limit:6 %}

<div class="bundle-card">

{% if product.compare_at_price_max > product.price %}

{% assign discount = product.compare_at_price_max | minus: product.price | times: 100 | divided_by: product.compare_at_price_max %}

<div class="bundle-card__badge">
Save {{ discount }}%
</div>

{% endif %}

<div class="bundle-card__image">

{% if product.featured_image %}

{{ product.featured_image
| image_url: width: 500
| image_tag:
class: 'bundle-card__img',
loading: 'lazy'
}}

{% endif %}

</div>

<div class="bundle-card__body">

<h4 class="bundle-card__title">
{{ product.title }}
</h4>

<p class="bundle-card__desc">
{{ product.description | strip_html | truncate: 80 }}
<a href="{{ product.url }}">Learn More</a>
</p>

{% assign color_index = nil %}

{% for option in product.options %}

{% assign option_name = option | downcase %}

{% if option_name contains 'color' %}
{% assign color_index = forloop.index0 %}
{% endif %}

{% endfor %}

{% if color_index != nil %}

<div class="bundle-card__variants">

{% assign shown_colors = '' %}

{% for variant in product.variants %}

{% assign color_value = variant.options[color_index] %}

{% unless shown_colors contains color_value %}

<div class="bundle-card__variant">

{% if variant.image %}

{{ variant.image
| image_url: width: 50
| image_tag:
class: 'bundle-card__variant-img'
}}

{% endif %}

<span>{{ color_value }}</span>

</div>

{% assign shown_colors = shown_colors | append: color_value | append: ',' %}

{% endunless %}

{% endfor %}

</div>

{% endif %}

<div class="bundle-card__footer">

<div class="bundle-qty">

<button class="qty-btn minus">-</button>

<span class="qty-value">1</span>

<button class="qty-btn plus">+</button>

</div>

<div class="bundle-price">

{% if product.compare_at_price_max > product.price %}
<span class="old-price">
{{ product.compare_at_price_max | money }}
</span>
{% endif %}

<span class="new-price">
{{ product.price | money }}
</span>

</div>

</div>

</div>

</div>

{% endfor %}

</div>

<button class="bundle-next-btn">
{{ block.settings.next_button_label }}
</button>

{% else %}

<p class="bundle-empty">
Please select a collection for this step.
</p>

{% endif %}

</div>

</details>

</div>

{% endfor %}

</div>

<style>

.bundle-steps{
background:#f4f6fb;
}

.bundle-steps__container{
max-width:1400px;
margin:auto;
}

.bundle-step{
margin-bottom:30px;
}

.bundle-step__label{
font-size:12px;
color:#98a0bd;
text-transform:uppercase;
margin-bottom:6px;
font-weight:600;
}

.bundle-step__accordion{
background:#fff;
border-radius:10px;
border:1px solid #e5e8f6;
}

.bundle-step__header{
padding:18px;
cursor:pointer;
font-weight:700;
font-size:18px;
}

.bundle-step__content{
padding:20px;
background:#f5f7ff;
border-radius:0 0 10px 10px;
}

.bundle-products{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:20px;
}

.bundle-card{
background:#fff;
border-radius:16px;
padding:20px;
border:2px solid #7566ff;
position:relative;
display:flex;
flex-direction:column;
gap:12px;
}

.bundle-card__badge{
position:absolute;
top:14px;
left:14px;
background:#5a4be7;
color:#fff;
padding:5px 12px;
border-radius:20px;
font-size:12px;
}

.bundle-card__image{
height:160px;
display:flex;
align-items:center;
justify-content:center;
}

.bundle-card__img{
max-height:100%;
object-fit:contain;
}

.bundle-card__title{
font-size:18px;
font-weight:700;
}

.bundle-card__desc{
font-size:14px;
color:#666;
}

.bundle-card__variants{
display:flex;
gap:8px;
flex-wrap:wrap;
}

.bundle-card__variant{
display:flex;
align-items:center;
gap:6px;
border:1px solid #ddd;
padding:4px 8px;
border-radius:6px;
font-size:13px;
}

.bundle-card__variant-img{
width:18px;
height:18px;
}

.bundle-card__footer{
display:flex;
justify-content:space-between;
align-items:center;
margin-top:8px;
}

.bundle-qty{
display:flex;
align-items:center;
gap:10px;
}

.qty-btn{
width:30px;
height:30px;
border:none;
background:#eef1f7;
border-radius:6px;
cursor:pointer;
font-size:18px;
}

.qty-value{
font-weight:600;
}

.old-price{
text-decoration:line-through;
color:#e74c3c;
margin-right:6px;
}

.new-price{
font-weight:700;
}

.bundle-next-btn{
margin-top:20px;
padding:10px 24px;
border-radius:999px;
border:1px solid #b8c2ff;
background:#f5f7ff;
color:#3657ff;
font-weight:700;
cursor:pointer;
}

@media(max-width:1024px){

.bundle-products{
grid-template-columns:repeat(2,1fr);
}

}

@media(max-width:600px){

.bundle-products{
grid-template-columns:1fr;
}

}

</style>

<script>

document.addEventListener("click",function(e){

if(e.target.classList.contains("plus")){

let qty=e.target.parentElement.querySelector(".qty-value")
qty.innerText=parseInt(qty.innerText)+1

}

if(e.target.classList.contains("minus")){

let qty=e.target.parentElement.querySelector(".qty-value")
let val=parseInt(qty.innerText)

if(val>1){
qty.innerText=val-1
}

}

})

</script>

{% schema %}
{
"name": "Bundle Steps",
"settings": [
{
"type": "range",
"id": "padding_top",
"label": "Padding Top",
"default": 40,
"min": 0,
"max": 100
},
{
"type": "range",
"id": "padding_bottom",
"label": "Padding Bottom",
"default": 40,
"min": 0,
"max": 100
},
{
"type": "range",
"id": "margin_top",
"label": "Margin Top",
"default": 0,
"min": 0,
"max": 100
},
{
"type": "range",
"id": "margin_bottom",
"label": "Margin Bottom",
"default": 0,
"min": 0,
"max": 100
}
],
"blocks": [
{
"type": "step",
"name": "Bundle Step",
"settings": [
{
"type": "text",
"id": "step_heading",
"label": "Step Heading",
"default": "Choose Product"
},
{
"type": "collection",
"id": "collection",
"label": "Collection"
},
{
"type": "text",
"id": "next_button_label",
"label": "Next Button Label",
"default": "Next"
}
]
}
],
"presets": [
{
"name": "Bundle Steps",
"blocks": [
{ "type": "step" },
{ "type": "step" },
{ "type": "step" }
]
}
]
}
{% endschema %}